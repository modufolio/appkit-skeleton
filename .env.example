APP_ENV=dev
APP_URL=http://localhost:8000

# Set to true in production behind HTTPS so the session cookie carries
# the Secure flag (browsers will then refuse to send it over plain HTTP).
COOKIE_SECURE=false

# Note: HSTS / CSP / X-Frame-Options / X-Content-Type-Options should be set
# by your reverse proxy (nginx, Caddy, CDN), not the application.
